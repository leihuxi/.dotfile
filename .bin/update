#!/usr/bin/env bash
# Update everything: brew, oh-my-zsh, oh-my-tmux + tmux plugins, nvim plugins + Mason tools,
# gh extensions, yazi, ccusage, vimrc.
# Usage: update     (a failing step does not stop the others; failures are listed at the end)
export PATH="/opt/homebrew/bin:$PATH"
case $1 in
  -h | --help) sed -n '2,4s/^# \{0,1\}//p' "$0"; exit 0 ;;
  "") ;;
  *) echo "update: takes no arguments (try --help)" >&2; exit 2 ;;
esac
failed=()
step() {
  local name=$1; shift
  printf '\n\033[1;34m==> %s\033[0m\n' "$name"
  "$@" || failed+=("$name")
}

step brew               bash -c 'brew update && brew upgrade && brew cleanup -q'
step oh-my-zsh          env ZSH="${ZSH:-$HOME/.oh-my-zsh}" zsh "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh"
step oh-my-tmux         git -C "$HOME/.local/share/oh-my-tmux" pull --ff-only -q
step "tmux plugins"     "$HOME/.config/tmux/plugins/tpm/bin/update_plugins" all
# tmux-thumbs has no arm64 binary, so rebuild it after the plugin updates
step tmux-thumbs        bash -c 'cd "$HOME/.config/tmux/plugins/tmux-thumbs" && cargo build --release -q'
step "nvim plugins"     nvim --headless "+Lazy! sync" +qa
step "Mason tools"      nvim --headless "+Lazy! load mason.nvim" -c 'lua
  local reg = require("mason-registry")
  reg.refresh() -- synchronous; no vim.wait afterwards (returns at once in headless mode), quit from the install callback
  local pending = 0
  for _, p in ipairs(reg.get_installed_packages()) do
    local cur, new = p:get_installed_version(), p:get_latest_version()
    if cur and new and cur ~= new then
      pending = pending + 1
      print(p.name .. " " .. cur .. " -> " .. new .. "\n")
      p:install({}, vim.schedule_wrap(function(ok)
        print(p.name .. (ok and " updated" or " update failed") .. "\n")
        pending = pending - 1
        if pending == 0 then vim.cmd("qa!") end
      end))
    end
  end
  if pending == 0 then print("Mason tools are up to date\n"); vim.cmd("qa!") end'
step "gh extensions"    gh extension upgrade --all
step yazi               ya pkg upgrade
step ccusage            npm install --global --silent ccusage@latest
step "vimrc (MacVim)"   git -C "$HOME/.vim_runtime" pull --ff-only -q

echo
if ((${#failed[@]})); then
  printf '\033[1;31mFailed: %s\033[0m\n' "${failed[*]}"; exit 1
fi
printf '\033[1;32mAll updates done\033[0m\n'
