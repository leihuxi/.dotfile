#!/usr/bin/env bash
# Claude Code status line (settings.json -> statusLine).
#   󰚩 Opus 5.5 │  Code  main* │ ▰▰▱▱▱▱▱▱▱▱ 17% │ $6.63 │ +43 -3
# Uses the terminal's 16 ANSI colours so it follows Ghostty's light/dark theme.
export PATH="/opt/homebrew/bin:$PATH"
in=$(cat)
j() { jq -r "$1 // empty" <<<"$in" 2>/dev/null; }

model=$(j .model.display_name)
dir=$(j .workspace.current_dir)
pct=$(j .context_window.used_percentage)
cost=$(j .cost.total_cost_usd)
added=$(j .cost.total_lines_added)
removed=$(j .cost.total_lines_removed)
week=$(j .rate_limits.seven_day.used_percentage)
five=$(j .rate_limits.five_hour.used_percentage)

dim=$'\e[2m' reset=$'\e[0m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' blue=$'\e[34m' magenta=$'\e[35m' cyan=$'\e[36m'
sep="${dim} │ ${reset}"
out="${magenta}󰚩 ${model:-Claude}${reset}"

if [[ -n $dir ]]; then
  out+="${sep}${blue} ${dir##*/}${reset}"
  # --no-optional-locks: never take the index lock (safe next to other git commands)
  if branch=$(git --no-optional-locks -C "$dir" branch --show-current 2>/dev/null) && [[ -n $branch ]]; then
    dirty=$(git --no-optional-locks -C "$dir" status --porcelain -uno 2>/dev/null | head -1)
    out+="  ${cyan} ${branch}${dirty:+*}${reset}"
  fi
fi

if [[ -n $pct ]]; then
  p=${pct%.*}
  color=$green
  ((p >= 50)) && color=$yellow
  ((p >= 80)) && color=$red
  filled=$(((p + 5) / 10))
  ((filled > 10)) && filled=10
  bar=$(printf '%*s' "$filled" '' | sed 's/ /▰/g')$(printf '%*s' $((10 - filled)) '' | sed 's/ /▱/g')
  out+="${sep}${color}${bar} ${p}%${reset}"
fi

[[ -n $cost ]] && out+="${sep}${yellow}\$$(printf '%.2f' "$cost")${reset}"
if [[ "${added:-0}${removed:-0}" != 00 ]]; then
  out+="${sep}${green}+${added:-0}${reset} ${red}-${removed:-0}${reset}"
fi

# Plan limits: only shown once they are worth worrying about (>= 50%)
limits=""
[[ -n $five && ${five%.*} -ge 50 ]] && limits+="5h ${five%.*}% "
[[ -n $week && ${week%.*} -ge 50 ]] && limits+="7d ${week%.*}%"
[[ -n $limits ]] && out+="${sep}${red}${limits% }${reset}"

printf '%s\n' "$out"
