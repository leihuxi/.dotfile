#!/bin/sh
# tmux 状态栏：显示 pane 所在目录的 git 分支（不在仓库时不输出）
cd "${1:-.}" 2>/dev/null || exit 0
# 状态栏会在任意目录（包括不可信的仓库）里自动运行：禁用仓库可配置的命令执行（fsmonitor），且不写锁文件
g() { git --no-optional-locks -c core.fsmonitor=false -c core.untrackedCache=false "$@"; }
b=$(g branch --show-current 2>/dev/null) || exit 0
[ -n "$b" ] || b=$(g rev-parse --short HEAD 2>/dev/null) || exit 0
[ -n "$(g status --porcelain --untracked-files=no 2>/dev/null | head -1)" ] && d='*' || d=''
printf ' %s%s  ' "$b" "$d"
