#!/usr/bin/env bash
# tmux-sessionizer: pick an existing session or a project directory with fzf, then
# create / switch to its tmux session
#   tmux-sessionizer          interactive
#   tmux-sessionizer <dir>    open a session for that directory
set -uo pipefail

SESSION_ICON='󰆍'
DIR_ICON=''
ROOTS=("$HOME/Code" "$HOME/work" "$HOME/Projects" "$HOME/.dotfile")

candidates() {
    tmux list-sessions -F "$SESSION_ICON #{session_name}" 2>/dev/null
    {
        command -v zoxide >/dev/null && zoxide query -l 2>/dev/null
        for r in "${ROOTS[@]}"; do
            [[ -d $r ]] || continue
            echo "$r"
            if command -v fd >/dev/null; then
                fd --max-depth 3 --type d --hidden --no-ignore --prune -g .git "$r" 2>/dev/null | sed 's|/\.git/*$||'
            fi
        done
    } | awk '!seen[$0]++' | sed "s|^$HOME|~|; s|^|$DIR_ICON |"
}

if [[ $# -ge 1 ]]; then
    selected="$DIR_ICON $1"
else
    selected=$(candidates | fzf --reverse --ansi --no-sort \
        --prompt='session / project ❯ ' \
        --header='Enter: switch session, or create one for the directory' \
        --preview-window='right,55%' \
        --preview "item={2..}; if [[ {1} == '$SESSION_ICON' ]]; then tmux capture-pane -ep -t \"\$item\" 2>/dev/null; else eza --tree --level=2 --color=always --icons=always \"\${item/#\\~/\$HOME}\" 2>/dev/null | head -80; fi") || exit 0
fi

icon=${selected%% *}
item=${selected#* }

if [[ $icon == "$SESSION_ICON" ]]; then
    name=$item
else
    dir=${item/#\~/$HOME}
    dir=$(cd "$dir" 2>/dev/null && pwd) || { echo "no such directory: $item" >&2; exit 1; }
    name=$(basename "$dir" | tr '.:' '__')
    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$dir"
fi

if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "=$name"
else
    tmux attach-session -t "=$name"
fi
