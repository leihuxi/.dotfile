# macOS packages: brew bundle --file ~/.dotfile/Brewfile

# shell / tmux
brew "zsh"
brew "tmux"
brew "starship"
brew "fzf"
brew "laishulu/homebrew/macism"   # switch input method from the CLI (Esc in vim / zsh -> English)
brew "zoxide"

# Modern CLI
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "git-delta"
brew "lazygit"
brew "tlrc"
brew "atuin"
brew "yazi"
brew "carapace"
brew "thefuck"
brew "jq"
brew "ccusage"              # Claude usage in the tmux status bar (.bin/claude-tmux-status)

# vim (coc.nvim needs node, tagbar needs universal-ctags, vim's python3 support needs python)
brew "vim"
brew "neovim"                     # LazyVim config lives in .config/nvim
brew "python"
brew "node"
brew "rust"                       # builds tmux-thumbs (no official Apple Silicon binary)
brew "universal-ctags"

# Terminal / editors / fonts
cask "ghostty"
cask "input-source-pro"          # per-app input method (Ghostty defaults to English)
cask "macvim-app"
cask "font-jetbrains-mono-nerd-font"

# Claude Code auto-format hook (.bin/claude-format)
brew "ruff"
brew "shfmt"
brew "stylua"
brew "prettier"

# System monitoring / markdown
brew "btop"                       # tmux prefix i popup
brew "dust"                       # directory sizes
brew "duf"                        # disk usage
brew "difftastic"                 # git dft / dlog / dshow
brew "glow"                       # render markdown in the terminal (used by cheat)
