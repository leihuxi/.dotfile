# macOS 软件清单：brew bundle --file ~/.dotfile/Brewfile

# shell / tmux
brew "zsh"
brew "tmux"
brew "starship"
brew "fzf"
brew "laishulu/homebrew/macism"   # 命令行切换输入法（vim / zsh 按 Esc 切英文）
brew "zoxide"

# 现代 CLI
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "git-delta"
brew "lazygit"
brew "tlrc"
brew "atuin"
brew "yazi"
brew "carapace"
brew "thefuck"
brew "jq"
brew "ccusage"              # tmux 状态栏的 Claude 用量（.bin/claude-tmux-status）

# vim（coc.nvim 需要 node，tagbar 需要 universal-ctags，vim 的 python3 支持需要 python）
brew "vim"
brew "neovim"                     # LazyVim 配置在 .config/nvim
brew "python"
brew "node"
brew "rust"                       # 编译 tmux-thumbs（官方无 Apple Silicon 预编译包）
brew "universal-ctags"

# 终端 / 编辑器 / 字体
cask "ghostty"
cask "input-source-pro"          # 按 App 自动切输入法（Ghostty 默认英文）
cask "macvim-app"
cask "font-jetbrains-mono-nerd-font"
